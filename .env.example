# Set ONE of these — Demand Radar auto-detects the provider from whichever key is present.
# With no key it still runs end to end in offline heuristic mode.

# Google Gemini (default) — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic Claude — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
